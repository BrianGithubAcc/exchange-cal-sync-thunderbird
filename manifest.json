{
  "manifest_version": 2,
  "name": "Exchange Calendar Sync",
  "version": "2.0.8",
  "description": "Two-way Microsoft Exchange calendar sync through EWS and Thunderbird's native Calendar.",
  "author": "Peter Schenkel",
  "browser_specific_settings": {
    "gecko": {
      "id": "exchange-calendar-sync-local@brian",
      "strict_min_version": "128.0",
      "strict_max_version": "153.*"
    }
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "64": "icons/icon-64.svg"
  },
  "background": {
    "scripts": [
      "ews/xml-builder.js",
      "ews/client.js",
      "sync/engine.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "permissions": [
    "storage",
    "alarms",
    "https://login.microsoftonline.com/*",
    "https://outlook.office365.com/*"
  ],
  "experiment_apis": {
    "CalendarAPI": {
      "schema": "api/CalendarAPI/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["CalendarAPI"]],
        "script": "api/CalendarAPI/implementation.js"
      }
    },
    "SecureStorage": {
      "schema": "api/SecureStorage/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["SecureStorage"]],
        "script": "api/SecureStorage/implementation.js"
      }
    }
  },
  "browser_action": {
    "default_title": "Exchange Calendar Sync",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    }
  }
}
